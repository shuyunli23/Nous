{
  "name": "generate_image",
  "description": "Generate an image from a text prompt and save it under exports. Returns download_url.",
  "parameters": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "Full image prompt (subject, camera, lighting, style, negative constraints)."
      },
      "size": {
        "type": "string",
        "enum": ["1024x1024", "1024x1792", "1792x1024"],
        "default": "1024x1024"
      },
      "filename_hint": {
        "type": "string",
        "description": "Optional short filename stem."
      }
    },
    "required": ["prompt"]
  },
  "runner": {
    "kind": "python",
    "entry": "tools/scripts/generate_image.py",
    "timeout_sec": 90,
    "memory_mb": 512,
    "network": true,
    "env_allow": ["OPENAI_API_KEY", "IMAGE_API_BASE", "IMAGE_API_KEY"]
  }
}
