# ---------------------------------------------------------------------------
# Nous - environment configuration
# Copy to .env and adjust. Every value below has a working default except
# LLM_API_KEY, which you must provide for phase 2+ (LLM calls).
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=nous
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Docker compose (Postgres):
# DATABASE_URL=postgresql+asyncpg://skill:skill@postgres:5432/skillagent
# Local dev without Docker (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/skillagent.db
DB_ECHO=false
DB_AUTO_CREATE=true

# --- LLM (any OpenAI-compatible endpoint) ---
# These are the FALLBACK values, used whenever no provider is active in the UI.
# You can skip them entirely and configure providers at 设置 (/settings) instead.
#
# DeepSeek:  https://api.deepseek.com/v1        model: deepseek-chat
# OpenAI:    https://api.openai.com/v1          model: gpt-4o-mini
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Runtime provider overrides (UI-configurable) ---
# Providers added at /settings are stored here and survive restarts. The file is
# gitignored but holds credentials in cleartext, so keep it on a trusted machine.
# Set RUNTIME_LLM_CONFIG_ENABLED=false on a shared host to make .env the only
# source of credentials and turn the write endpoints off.
RUNTIME_LLM_CONFIG_ENABLED=true
LLM_PROVIDER_STORE=./data/llm_providers.json

# AWS Bedrock is supported as a provider kind and needs the optional SDK:
#   pip install -r requirements-aws.txt
# Credentials are entered in the UI, not here. boto3 also honours the standard
# AWS_* environment variables and ~/.aws/credentials profiles if you prefer:
# AWS_REGION=us-west-2
# AWS_PROFILE=my-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Embeddings ---
# remote = OpenAI-compatible /embeddings endpoint
# local  = sentence-transformers in-process (pip install -r requirements-local.txt)
# hash   = deterministic fallback, no network, no model (dev/tests only)
EMBEDDING_PROVIDER=remote
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=1536
EMBEDDING_FALLBACK_TO_HASH=true

# --- Vector store ---
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=skills

# --- Agent / memory ---
MEMORY_MAX_TURNS=32
MEMORY_MAX_CHARS=48000
AGENT_MAX_TOOL_LOOPS=4

# --- Skill retrieval ---
SKILL_TOP_K=3
SKILL_MIN_SIMILARITY=0.28
SKILL_KEYWORD_BOOST=0.15
SKILL_CANDIDATE_POOL=12

# --- Skill extraction ---
EXTRACTION_ENABLED=true
EXTRACTION_MIN_MESSAGES=4
EXTRACTION_MIN_CONFIDENCE=0.6
EXTRACTION_DEDUPE_THRESHOLD=0.9
EXTRACTION_AUTO_ACTIVATE=false
SKILL_AUTO_DISABLE_FAILURES=3

# --- Image generation (文生图) ---
# Option A: Hugging Face Inference Providers (fal-ai / Flux) — matches:
#   InferenceClient(provider="fal-ai", api_key=os.environ["HF_TOKEN"])
# IMAGE_PROVIDER=huggingface
# IMAGE_HF_PROVIDER=fal-ai
# IMAGE_MODEL=black-forest-labs/FLUX.1-dev
# HF_TOKEN=hf_xxxxxxxx
# IMAGE_API_KEY=hf_xxxxxxxx
#
# Option B: OpenAI-compatible Images API
# IMAGE_PROVIDER=openai
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=dall-e-3
#
# Option C: If no image key is set and the active UI provider is AWS Bedrock,
# Nous calls IMAGE_BEDROCK_MODEL (default amazon.nova-canvas-v1:0) with the same
# Bedrock credentials.
# IMAGE_BEDROCK_MODEL=amazon.nova-canvas-v1:0
IMAGE_TIMEOUT_SECONDS=180

# --- Web search ---
# Default (auto): BRAVE/TAVILY/SERPER if keyed, else DuckDuckGo HTML + ddgs (free).
# Paid keys are strongly recommended for quality/speed (Brave Search free tier works well).
# WEB_SEARCH_PROVIDER=auto
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# WEB_SEARCH_TIMEOUT_SECONDS=15
# WEB_SEARCH_DDGS_BACKENDS=bing,duckduckgo,brave

# --- Owner unlock (LAN) ---
# This computer (localhost) enters Nous without a password.
# Other machines on the LAN must enter this password first.
# Empty NOUS_OWNER_PASSWORD uses Harmony ADMIN_PASSWORD (default admin123).
# Harmony guest accounts still cannot enter Nous.
# NOUS_OWNER_PASSWORD=
# NOUS_SESSION_SECRET=
# NOUS_SESSION_DAYS=30
# ADMIN_PASSWORD=admin123

# --- Dev convenience ---
DEFAULT_USER_EXTERNAL_ID=local-dev
